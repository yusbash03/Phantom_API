<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1707: underscores in test names; CA2007: ConfigureAwait in tests -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1515;CA1001;CA1861;CA2234;CA1849</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="FsCheck.Xunit.v3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PHANTOM.API\PHANTOM.API.csproj" />
    <ProjectReference Include="..\..\src\PHANTOM.Infrastructure\PHANTOM.Infrastructure.csproj" />
  </ItemGroup>
</Project>
