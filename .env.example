# Placeholders only. For local development prefer `dotnet user-secrets` (see README).
# In deployment (Render), set these as environment variables.

ASPNETCORE_ENVIRONMENT=Development

# Npgsql keyword format. Neon: use the direct (non "-pooler") host when migrations run from the app.
ConnectionStrings__Phantom=Host=<host>;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require;Channel Binding=Require

# >= 32 random bytes, e.g. `openssl rand -base64 48`
Jwt__SigningKey=<random-secret>

Cors__AllowedOrigins__0=http://localhost:5173

Seed__Enabled=false
Seed__DemoUserPassword=<demo-password-min-12-chars>

# Only for docker-compose.yml (optional offline database)
POSTGRES_PASSWORD=<local-password>

# Phase 3 integrations (not yet used)
Ai__ApiKey=<gemini-api-key>
Mapbox__SecretToken=<mapbox-secret-token>
