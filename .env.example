# Placeholders only. For local development prefer `dotnet user-secrets` (see README).
# In deployment (Render), set these as environment variables.

ASPNETCORE_ENVIRONMENT=Development

# Npgsql keyword format. Neon: use the direct (non "-pooler") host when migrations run from the app.
ConnectionStrings__Phantom=Host=<host>;Database=<db>;Username=<user>;Password=<password>;SSL Mode=Require;Channel Binding=Require

# >= 32 random bytes, e.g. `openssl rand -base64 48`
Jwt__SigningKey=<random-secret>

Cors__AllowedOrigins__0=http://localhost:5173

Seed__Enabled=false
Seed__DemoUserPassword=<demo-password-min-12-chars>

# Only for docker-compose.yml (optional offline database)
POSTGRES_PASSWORD=<local-password>

# Integrations. Without a Gemini key, Development uses a labelled simulated AI; elsewhere analyses fail honestly.
Ai__ApiKey=<gemini-api-key>
# Server-side Mapbox token for geocoding (never sent to the browser; the SPA has its own URL-restricted public token).
Mapbox__AccessToken=<mapbox-server-token>

# Optional. Key for the HMAC of reporter IPs kept for abuse analysis; derived from Jwt__SigningKey when unset.
# Privacy__IpHashKey=<random-secret>

# Optional. Sign-in limits: failures per account and client within the window, and the absolute session length.
# Auth__MaxFailedLoginsPerAccount=10
# Auth__FailedLoginWindowMinutes=15
# Auth__AbsoluteSessionLifetimeDays=30

# Behind Render's load balancer only: trust its X-Forwarded-For so rate limits see real client IPs.
# ForwardedHeaders__TrustPlatformProxy=true
