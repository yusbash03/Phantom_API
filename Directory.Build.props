<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML comments; CA1848/CA1873: LoggerMessage delegates (structured templates are used instead); CA1711/CA1716/CA1724: naming collisions with domain terms -->
    <NoWarn>$(NoWarn);CS1591;CA1848;CA1873;CA1711;CA1716;CA1724</NoWarn>
  </PropertyGroup>
</Project>
