<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="AWSSDK.S3" />
    <!-- Linux native library for the Render container image (macOS/Windows assets ship with SkiaSharp). -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PHANTOM.Application\PHANTOM.Application.csproj" />
    <ProjectReference Include="..\PHANTOM.Domain\PHANTOM.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Intelligence\Fixtures\*.json" LogicalName="PHANTOM.Fixtures.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Weather\Fixtures\*.json" LogicalName="PHANTOM.Fixtures.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PHANTOM.UnitTests" />
    <InternalsVisibleTo Include="PHANTOM.IntegrationTests" />
  </ItemGroup>
</Project>
