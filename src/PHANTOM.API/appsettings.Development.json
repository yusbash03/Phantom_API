{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "RateLimiting": {
    "LoginPermitsPerMinute": 100
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Seed": {
    "Enabled": true
  }
}
