{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Phantom": ""
  },
  "Jwt": {
    "Issuer": "phantom-api",
    "Audience": "phantom-ui",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15
  },
  "Auth": {
    "RefreshTokenLifetimeDays": 7,
    "MaxFailedLoginsPerAccount": 10,
    "FailedLoginWindowMinutes": 15
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "PublicPermitsPerMinute": 20,
    "LoginPermitsPerMinute": 10,
    "RefreshPermitsPerMinute": 60
  },
  "ForwardedHeaders": {
    "TrustPlatformProxy": false
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "Enabled": false,
    "AllowDemoInProduction": false
  },
  "OpenApi": {
    "ExposeUi": false
  }
}
